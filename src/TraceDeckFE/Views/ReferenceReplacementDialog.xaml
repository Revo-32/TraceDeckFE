<Window x:Class="TraceDeckFE.Views.ReferenceReplacementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TraceDeckFE.Localization"
        Title="{loc:Text Dialog.ReplaceTitle}" Width="390" Height="190"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        FontFamily="{StaticResource PretendardFontFamily}"
        ShowInTaskbar="False" Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9"
            Background="{StaticResource PanelBrush}" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{loc:Text Dialog.ReplaceHeading}" FontWeight="SemiBold" FontSize="12" />
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,12,0,12" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Content="{loc:Text Ui.Cancel}" Margin="0,0,5,0" Style="{StaticResource NeutralButtonStyle}" IsCancel="True" />
                <Button Grid.Column="1" Content="{loc:Text Ui.Replace}" Margin="5,0,0,0" Style="{StaticResource NeutralButtonStyle}"
                        IsDefault="True" Click="OnReplaceClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
