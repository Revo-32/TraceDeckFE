<Window x:Class="TraceDeckFE.Views.WindowPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TraceDeckFE.Localization"
        Title="{loc:Text Dialog.TargetTitle}" Width="620" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="{StaticResource PretendardFontFamily}"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{loc:Text Dialog.TargetHeading}" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Text Dialog.TargetHelp}"
                       Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ListBox x:Name="WindowList" Grid.Row="1" ItemsSource="{Binding}"
                 DisplayMemberPath="DisplayLabel" MouseDoubleClick="OnWindowDoubleClick"
                 Background="{StaticResource PanelBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4" />
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Text Dialog.TargetHint}" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
            <Button Grid.Column="1" Content="{loc:Text Ui.Cancel}" Width="88" Margin="0,0,8,0"
                    IsCancel="True" Style="{StaticResource NeutralButtonStyle}" />
            <Button Grid.Column="2" Content="{loc:Text Ui.Connect}" Width="96" IsDefault="True"
                    Style="{StaticResource NeutralButtonStyle}" Click="OnConnectClick" />
        </Grid>
    </Grid>
</Window>
